rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Semua pengunjung boleh melihat postingan komunitas.
      allow read: if true;

      // Pengunjung harus masuk melalui Firebase Anonymous Auth.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'category', 'nickname', 'playerId', 'zoneId', 'note',
          'done', 'ownerUid', 'createdAt'
        ])
        && request.resource.data.category in ['like', 'mabar']
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 28
        && request.resource.data.playerId is string
        && request.resource.data.zoneId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 240
        && request.resource.data.done == false;

      // Hanya pemilik postingan yang dapat menandai selesai atau menghapusnya.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done'])
        && request.resource.data.done == true;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}